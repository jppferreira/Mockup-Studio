{
  "name": "mockup-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first 3D device mockup studio for macOS",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on http://127.0.0.1:5175 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "website": "vite --config website/vite.config.ts",
    "website:build": "vite build --config website/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "dist:mac:universal": "npm run build && electron-builder --mac dmg zip --universal"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.170.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.mockup.desktop",
    "productName": "Mockup Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
