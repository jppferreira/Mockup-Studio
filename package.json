{
  "name": "mockup-studio",
  "private": true,
  "version": "0.1.1",
  "license": "UNLICENSED",
  "description": "Local-first 3D device mockup studio for macOS",
  "productName": "Mockup Studio 3D",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "license:issue": "node scripts/issue-license.mjs",
    "fulfill:dev": "node server/index.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on http://127.0.0.1:5175 && node scripts/brand-electron-dev.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 electron .\"",
    "dev:app": "wait-on http://127.0.0.1:5175 && node scripts/brand-electron-dev.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5175 electron .",
    "dev:web": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "website": "vite --config website/vite.config.ts",
    "website:build": "vite build --config website/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 -c.mac.identity=null",
    "dist:mac:beta": "node scripts/dist-mac-beta.mjs",
    "dist:mac:universal": "npm run build && electron-builder --mac dmg zip --universal"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "electron-updater": "^6.8.11",
    "gifenc": "^1.0.3",
    "kiwi-schema": "^0.5.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.65.1",
    "mp4-muxer": "^5.2.2",
    "pako": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.170.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^22.10.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.mockup.desktop",
    "productName": "Mockup Studio 3D",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "jppferreira",
      "repo": "Mockup-Studio"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "afterSign": "scripts/notarize.cjs",
    "fileAssociations": [
      {
        "ext": "mockup",
        "name": "Mockup Studio Project",
        "description": "Mockup Studio Project",
        "mimeType": "application/x-mockup-studio",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Mockup Studio uses camera access to mirror your iPhone or iPad screen over USB into the 3D mockup."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": true
    }
  }
}
