# Copy to .env.local (app) and/or website/.env.local
#
# Preferred commerce path: Stripe Checkout via Supabase Edge Functions
# (create-checkout / billing-portal / stripe-webhook). Keep STRIPE_SECRET_KEY
# only in Edge Function secrets — never in VITE_* or Electron.
#
# Legacy payment-link fallback (Lemon / Paddle / Stripe Payment Links):
VITE_CHECKOUT_PRO_URL=
VITE_CHECKOUT_PRO_MAX_URL=
VITE_CHECKOUT_UPDATE_PASS_URL=

# Issue signed keys with: npm run license:issue -- pro|pro_max|update_pass
# Delivered keys look like: MS-PRO.<payload>.<sig> / MS-PROMAX.<payload>.<sig>
# Fulfillment + feedback API (Resend lives in server/.env as RESEND_API_KEY)
# App FeedbackModal + website ContactModal POST to {VITE_FULFILL_API_URL}/feedback
# Local: npm run fulfill:dev   ·  Production: your public fulfill host
VITE_FULFILL_API_URL=http://127.0.0.1:8787

# Build channel for packaged desktop (also set by npm run dist:mac / dist:mac:mas)
# MOCKUP_DISTRIBUTION=mac_direct
# MOCKUP_DISTRIBUTION=mac_mas

# Direct link to the Apple Silicon .dmg (GitHub Release asset, R2/S3, CDN, etc.)
# Build with: npm run dist:mac  →  upload release/*.dmg  →  paste the public URL here
VITE_DOWNLOAD_MAC_URL=https://github.com/jppferreira/Mockup-Studio/releases/latest/download/mokstudio-0.1.1-arm64.dmg

# --- Mac open-beta signing + notarization (required so Gatekeeper does not block) ---
# 1. Create "Developer ID Application" at https://developer.apple.com/account/resources/certificates/list
#    Install the .cer into Keychain (must match identity below / Team HG7F63WLGK).
# 2. Notarize with either API key OR Apple ID + app-specific password:
# APPLE_TEAM_ID=HG7F63WLGK
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   — or —
# APPLE_API_KEY=/path/to/AuthKey_XXXXXX.p8
# APPLE_API_KEY_ID=XXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SKIP_NOTARIZE=1   # local-only builds; do NOT ship these to other Macs

# Shown on /thanks and used when building success redirects in docs
VITE_SITE_URL=https://mokstudio.io

# Fallback when a checkout URL is missing — Buy buttons become mailto:
VITE_SALES_EMAIL=sales@mokstudio.io

# Web studio only. The Mac app never asks for this.
# Put the real password in .env.local as SITE_GATE_PASSWORD (no VITE_ prefix).
# The build stores a hash, not the password. Leave it blank to leave the web app open.
# SITE_GATE_PASSWORD=

# Marketing website (website/) launch gate — any route prompts for this password first.
# Put the real value in website/.env.local or website/.env.production (no VITE_ prefix).
# The build stores a SHA-256 hash only. Leave blank to leave the marketing site open.
# SITE_PASSWORD=
# (Alias also accepted: SITE_GATE_PASSWORD=)

# --- Supabase (device models + private cloud project sync) ---
# GLBs are NOT in git. The app requests a short-lived signed URL per device.
# Cloud saves use the same project: email OTP + optional Google / Apple OAuth.
# Auth → Providers: enable Email (OTP), Google, and Apple.
# Auth → URL config: add http://127.0.0.1:5175/**, https://mokstudio.io/app/**,
# and mokstudio://auth/callback (desktop Google/Apple returns here like Figma).
# Never put the service-role key in the app.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# VITE_MODEL_APP_SECRET=shared-secret-matching-edge-function-MODEL_APP_SECRET
# Upload meshes: node scripts/upload-device-models.mjs  (needs SUPABASE_SERVICE_ROLE_KEY)
#
# Edge Function secrets (Supabase dashboard / CLI — not VITE_):
# Never paste sk_test_ / sk_live_ onto the shell argv or into chat.
# Prefer: npx supabase secrets set --env-file /tmp/stripe.env --project-ref …
# If a secret leaked: docs/stripe-secret-rotation.md
# STRIPE_MODE=test                    # test | live  (default: test)
# STRIPE_SECRET_KEY_TEST=sk_test_...  # preferred test secret
# STRIPE_SECRET_KEY_LIVE=sk_live_...  # required when STRIPE_MODE=live
# STRIPE_SECRET_KEY=sk_test_...       # legacy fallback (test mode only)
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # legacy fallback (test mode only)
# STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
# STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
# STRIPE_PRICE_PRO_TEST=price_... / STRIPE_PRICE_PRO_LIVE=price_...
# STRIPE_PRICE_PRO=price_...          # legacy fallback for active mode
# STRIPE_PRICE_PRO_MAX=price_...
# STRIPE_PRICE_UPDATE_PASS=price_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_PRICE_LIFETIME=price_...
# LICENSE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# SITE_URL=https://mokstudio.io
#
# Marketing site (website/.env.local) — publishable keys only, never secrets:
# VITE_STRIPE_MODE=test
# VITE_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
#
# Full checklist: docs/release-licensing.md
