# Copy to .env.local (app) and/or website/.env.local
# Create products in Lemon Squeezy or Paddle, then paste Payment Link URLs here.
# License keys delivered by the store should match: MS-PRO-XXXXXX / MS-PROMAX-XXXXXX

VITE_CHECKOUT_PRO_URL=https://your-store.lemonsqueezy.com/checkout/buy/pro-variant-id
VITE_CHECKOUT_PRO_MAX_URL=https://your-store.lemonsqueezy.com/checkout/buy/pro-max-variant-id
VITE_CHECKOUT_UPDATE_PASS_URL=https://your-store.lemonsqueezy.com/checkout/buy/update-pass-variant-id

# Direct link to the Apple Silicon .dmg (GitHub Release asset, R2/S3, CDN, etc.)
# Build with: npm run dist:mac  →  upload release/*.dmg  →  paste the public URL here
VITE_DOWNLOAD_MAC_URL=https://github.com/you/Mockup-Studio/releases/latest/download/Mockup-Studio-arm64.dmg

# Shown on /thanks and used when building success redirects in docs
VITE_SITE_URL=https://mockupstudio.app

# Fallback when a checkout URL is missing — Buy buttons become mailto:
VITE_SALES_EMAIL=sales@mockupstudio.app
