# Copy to server/.env (gitignored)

FULFILL_HOST=127.0.0.1
FULFILL_PORT=8787

# Same PEM as scripts/.license-private-key.pem (use either file on disk or paste here)
# LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Dev-only fulfill endpoint secret (POST /dev/fulfill)
FULFILL_DEV_SECRET=dev-secret

# Resend (https://resend.com/api-keys) — leave unset for console dry-run
# Feedback + license emails both use this key.
# 1. Create an API key in Resend
# 2. Verify a sending domain (or keep onboarding@resend.dev for sandbox tests)
# 3. Set RESEND_API_KEY and restart: npm run fulfill:dev
RESEND_API_KEY=re_xxxxxxxx
LICENSE_EMAIL_FROM="Mockup Studio <onboarding@resend.dev>"
# Inbox for POST /feedback (app FeedbackModal + website ContactModal)
FEEDBACK_INBOX=hello@jppferreira.com

SITE_URL=https://mokstudio.io
VITE_DOWNLOAD_MAC_URL=https://github.com/you/Mockup-Studio/releases/latest/download/Mockup-Studio-arm64.dmg
# Comma-separated origins for browser recover / contact UI (localhost is always allowed in dev)
CORS_ORIGIN=https://mokstudio.io,http://127.0.0.1:5180,http://localhost:5173

# Lemon Squeezy
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_VARIANT_PRO=
LEMON_VARIANT_PRO_MAX=
LEMON_VARIANT_UPDATE_PASS=

# Paddle Billing
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_MAX=
PADDLE_PRICE_UPDATE_PASS=

# Optional override for idempotency JSON path
# LICENSE_STORE_PATH=/var/lib/mockup-studio/issued-licenses.json
